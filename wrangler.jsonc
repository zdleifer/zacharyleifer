{
  // Cloudflare Workers config for the exported Next.js site: worker/index.ts
  // only intercepts /api/report-download; every other request falls through
  // to the static export in ./out via the ASSETS binding.
  "name": "zacharyleifer",
  "compatibility_date": "2026-06-03",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "REPORT_LEADS", "id": "aab4332c282d43a2a9e14168a0a2d51a" }
  ],
  "routes": [
    { "pattern": "zacharyleifer.com", "custom_domain": true },
    { "pattern": "www.zacharyleifer.com", "custom_domain": true }
  ]
}
